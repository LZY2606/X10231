[
 {
  "seq": 1,
  "kind": "ingest",
  "payload": {
   "source": "fixture",
   "name": "adcp-janus-demo"
  },
  "check": {
   "id": "baseline-separate-streams",
   "expect": "all input streams recorded separately with units/basis"
  }
 },
 {
  "seq": 2,
  "kind": "source_change",
  "payload": {
   "stream": "bad_beam_flag",
   "ping": 5,
   "cell": 2,
   "beam": 1,
   "value": 1,
   "reason": "single-beam-failure"
  },
  "check": {
   "id": "single-beam-failure-local",
   "expect": "ping6 cell3 drops to 3-beam; neighbours stay 4-beam",
   "assert": {
    "scope_ping": 5,
    "scope_cell": 2,
    "mode": "3-beam",
    "affected_only": true
   }
  }
 },
 {
  "seq": 3,
  "kind": "check",
  "payload": {
   "id": "heading-crosses-360",
   "ping": 17,
   "expect": "interpolated heading travels short way 359->1"
  }
 },
 {
  "seq": 4,
  "kind": "source_gap",
  "payload": {
   "stream": "attitude",
   "ping": 11,
   "reason": "missing-attitude-sample"
  },
  "check": {
   "id": "no-interp-across-gap",
   "expect": "attitude at gap not interpolated; instrument stays valid",
   "assert": {
    "ping": 11,
    "attitude_status": "gap",
    "instrument_kept": true,
    "ship_earth": null
   }
  }
 },
 {
  "seq": 5,
  "kind": "source_change",
  "payload": {
   "stream": "correlation",
   "ping": 13,
   "cell": 2,
   "beam": 1,
   "value": 80,
   "reason": "marginal-beam-multi-solution"
  },
  "check": {
   "id": "three-beam-multiple-solutions",
   "expect": "4-beam solution plus 3-beam candidates retained, not merged",
   "assert": {
    "ping": 13,
    "cell": 2,
    "min_candidates": 4,
    "distinct_modes": [
     "4-beam",
     "3-beam"
    ]
   }
  }
 },
 {
  "seq": 6,
  "kind": "source_change",
  "payload": {
   "stream": "mount",
   "id": "mount-v2",
   "x_deg": 0.5,
   "y_deg": -0.5,
   "heading_alignment_deg": 1.5,
   "valid_from_ping": 11,
   "reason": "installation-survey-revision"
  },
  "check": {
   "id": "mount-revision-fingerprint",
   "expect": "earth velocities after ping12 change; instrument do not",
   "assert": {
    "instrument_unchanged": true,
    "fingerprint_changes": true
   }
  }
 },
 {
  "seq": 7,
  "kind": "branch",
  "payload": {
   "name": "xorder-pitch-roll",
   "tilt_order": "pitch-roll"
  },
  "check": {
   "id": "transform-order-in-fingerprint",
   "expect": "different order -> different deriv fingerprints/ids"
  }
 },
 {
  "seq": 8,
  "kind": "source_change",
  "payload": {
   "stream": "cell_invalid",
   "ping": 2,
   "cell": 0,
   "reason": "side-lobe-invalid-depth-cell"
  },
  "check": {
   "id": "invalid-depth-cell-excluded",
   "expect": "cell marked excluded with reason, evidence retained",
   "assert": {
    "ping": 2,
    "cell": 0,
    "status": "cell-invalid"
   }
  }
 },
 {
  "seq": 9,
  "kind": "decision",
  "payload": {
   "branch": "main",
   "ping": 13,
   "cell": 2,
   "action": "select-candidate",
   "candidate": "b1234",
   "label": "adopt-4beam"
  },
  "check": {
   "id": "conflicting-human-decisions-a"
  }
 },
 {
  "seq": 10,
  "kind": "decision",
  "payload": {
   "branch": "xorder-pitch-roll",
   "ping": 13,
   "cell": 2,
   "action": "select-candidate",
   "candidate": "b124",
   "label": "adopt-3beam-b124"
  },
  "check": {
   "id": "conflicting-human-decisions-b",
   "expect": "merging raises a resolvable conflict, nothing overwritten"
  }
 },
 {
  "seq": 11,
  "kind": "check",
  "payload": {
   "id": "rejected-candidates-retained",
   "expect": "non-selected 3-beam candidates remain present"
  }
 },
 {
  "seq": 12,
  "kind": "check",
  "payload": {
   "id": "derivation-fingerprint-triple",
   "expect": "order, beam geometry, declination version in fp"
  }
 }
]